{
  "name": "rescue-alert",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:tokens": "bash scripts/check-no-hex-emoji.sh"
  },
  "devDependencies": {
    "turbo": "2.11.2",
    "typescript": "^5.9.0",
    "prettier": "^3.6.0",
    "vitest": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.20.0",
    "@eslint/js": "^9.20.0",
    "typescript-eslint": "^8.24.0"
  }
}
